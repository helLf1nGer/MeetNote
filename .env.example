# API Keys
GROQ_API_KEY=your_groq_api_key_here
HUGGING_FACE_AUTH_TOKEN=your_huggingface_token_here

# Google Cloud Configuration (for cloud diarization)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/credentials.json
GOOGLE_CLOUD_PROJECT=your-project-id

# Processing Options
USE_CUDA=true
DEVELOPMENT_MODE=false

# Output Configuration
OUTPUT_DIRECTORY=path/to/output/directory

# Model Configuration
WHISPER_MODEL=medium.en
DIARIZATION_MODEL=speaker-diarization-3.1

# Optional: Colab Service (if using)
COLAB_SERVICE_URL=your_colab_service_url 